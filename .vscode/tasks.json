{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Godot: Open Editor",
      "type": "shell",
      "command": "${workspaceFolder}/run_godot.sh",
      "args": [
        "--editor",
        "--path",
        "${workspaceFolder}"
      ],
      "problemMatcher": []
    },
    {
      "label": "Godot: Run Headless Check",
      "type": "shell",
      "command": "${workspaceFolder}/run_godot.sh",
      "args": [
        "--headless",
        "--path",
        "${workspaceFolder}",
        "--quit"
      ],
      "problemMatcher": []
    },
    {
      "label": "Godot: Run Project",
      "type": "shell",
      "command": "${workspaceFolder}/run_godot.sh",
      "args": [
        "${workspaceFolder}/project.godot",
        "--scene",
        "res://scenes/main.tscn"
      ],
      "problemMatcher": []
    }
  ]
}
